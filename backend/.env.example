# Backend environment variables
# Copy to .env and fill in values. Do NOT commit .env to version control.

# PostgreSQL connection string for MANUAL (non-Docker) local development.
# With `docker compose up`, the backend container automatically uses
# `postgresql://satquery:satquery@db:5432/satquery` and this value is ignored.
# The Compose database service maps host port 5433 -> container 5432, so when
# running uvicorn on the host use port 5433 (or your own PostgreSQL instance).
#
# PostgreSQL:
DATABASE_URL=postgresql://satquery:satquery@localhost:5433/satquery
#
# SQLite alternative (persisting to ./data/app.db — keep ./data backed up, or
# rely on the `backend_data` volume when running under Docker):
# DATABASE_URL=sqlite:///./data/app.db

# JWT secret — use a strong random string in production
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Upload storage (local filesystem path)
UPLOAD_DIR=./uploads

# Maximum upload size in MB (default 50). Both /api/images/upload and
# /api/analysis reject larger payloads with HTTP 413. Change this value by
# setting MAX_UPLOAD_SIZE_MB in the environment; raise it alongside
# VITE_MAX_FILE_SIZE_MB in the frontend if you increase allowed uploads.
MAX_UPLOAD_SIZE_MB=50

# Frontend origin for CORS (production: your Vercel URL)
FRONTEND_URL=http://localhost:5173

# AI mode: "mock" returns deterministic results, "real" loads a model
AI_MODE=mock
MODEL_PATH=