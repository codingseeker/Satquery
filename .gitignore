# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Virtual environment
.venv/
venv/
env/

# Large data files — never commit these
training/data/images/
training/data/metadata/
training/data/processed/
training/data/raw/

# Training logs and outputs — allow evaluation results, ignore large checkpoints
training/outputs/logs/
training/outputs/checkpoints/

# Allow the evaluation results JSON
!training/outputs/satquery_evaluation.json

# Trained model weights — too large for GitHub (use HuggingFace Hub instead)
# Allow .gitkeep placeholder
training/models/*
!training/models/.gitkeep


# OS files
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
